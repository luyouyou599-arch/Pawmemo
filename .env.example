# Server-only configuration. Copy to .env locally; never put credentials in VITE_* variables.
# External service use requires project approval before enabling.
EXTERNAL_AI_ENABLED=false
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
CHAT_MODEL=
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_LANGUAGE=zh
PORT=5181
PAWMEMO_DIST=.pawmemo/build
# Prices must be confirmed for selected provider/model/region; no implicit free allowance.
AI_INPUT_CNY_PER_MILLION=
AI_OUTPUT_CNY_PER_MILLION=
ASR_CNY_PER_SECOND=
AI_MAX_INPUT_TOKENS=40000
AI_MAX_OUTPUT_TOKENS=1800
DEMO_BUDGET_CNY=50
DEMO_BUDGET_STOP_CNY=40
PAWMEMO_USAGE_FILE=.pawmemo/usage.json
